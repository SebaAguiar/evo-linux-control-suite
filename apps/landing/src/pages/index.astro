---
import deck from "../assets/screenshots/deck.png";
import controllerMobile from "../assets/screenshots/controller-mobile.png";
import "../styles/design.css";
import "../styles/landing.css";

const base = import.meta.env.BASE_URL.replace(/\/?$/, "/");
const title = "EVO Linux Control Suite — Control de Audient EVO en Linux";
const description =
  "Controla ganancia, 48 V y monitoreo de tu Audient EVO 4, 8 y 16 en Linux, también desde el móvil. Open source, sin telemetría.";
const canonical = "https://sebaaguiar.github.io/evo-linux-control-suite/";
const year = new Date().getFullYear();
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="theme-color" content="#111827" />
    <meta name="description" content={description} />
    <meta name="generator" content={Astro.generator} />
    <link rel="canonical" href={canonical} />
    <link rel="icon" type="image/svg+xml" href={`${base}favicon.svg`} />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=JetBrains+Mono:wght@400;500;600&display=swap"
    />
    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:locale" content="es_ES" />
    <meta name="twitter:card" content="summary_large_image" />
    <title>{title}</title>
  </head>
  <body>
          <div class="site">
            <header class="navbar">
              <a class="brand" href="#inicio"
                ><span class="brand-mark"
                  ><span class="brand-tick"></span
                  ><span class="brand-core"></span></span
                ><span>EVO <b>Linux Control Suite</b></span
                ><small>by Arsian</small></a
              >
              <nav class="nav-links">
                <a href="#caracteristicas">Características</a
                ><a href="#control-remoto">Control remoto</a
                ><a href="#compatibilidad">Compatibilidad</a
                ><a href="#changelog">Novedades</a
                ><a href="#instalacion">Instalación</a><a href="#faq">FAQ</a>
              </nav>
              <div class="nav-actions">
                <button class="theme-toggle" aria-label="Cambiar paleta" aria-pressed="false">
                  <i></i><span>Arsian Dark</span></button
                ><a
                  class="button button-ghost github-button"
                  href="https://github.com/SebaAguiar/evo-linux-control-suite"
                  ><svg
                    aria-hidden="true"
                    class="icon"
                    width="17"
                    height="17"
                    viewBox="0 0 24 24"
                    fill="none"
                    stroke="currentColor"
                    stroke-width="1.8"
                    stroke-linecap="round"
                    stroke-linejoin="round"
                  >
                    <path
                      d="M15 22v-3.9c.04-1-.35-1.96-1-2.6 3.28-.36 6.72-1.61 6.72-7.25A5.67 5.67 0 0 0 19.22 4.3 5.3 5.3 0 0 0 19.08.4S17.9.02 15 1.9a13.4 13.4 0 0 0-7 0C5.1.02 3.92.4 3.92.4a5.3 5.3 0 0 0-.14 3.9 5.67 5.67 0 0 0-1.5 3.95c0 5.63 3.44 6.88 6.72 7.25a3.4 3.4 0 0 0-1 2.6V22"
                    ></path>
                  </svg>
                  GitHub</a
                ><a class="button button-primary nav-download" href="#instalacion"
                  >Descargar v1.0.3</a
                ><button class="menu-button" aria-label="Abrir menú" aria-expanded="false">
                  <svg
                    aria-hidden="true"
                    class="icon"
                    width="20"
                    height="20"
                    viewBox="0 0 24 24"
                    fill="none"
                    stroke="currentColor"
                    stroke-width="1.8"
                    stroke-linecap="round"
                    stroke-linejoin="round"
                  >
                    <path d="M4 7h16M4 12h16M4 17h16"></path>
                  </svg>
                </button>
              </div>
            </header>
            <main>
              <section class="hero" id="inicio">
                <div class="hero-grid"></div>
                <div class="hero-copy reveal visible">
                  <div class="release-badge">
                    <span>Versión actual: v1.0.3</span><i></i> Lanzamiento estable · Compatible con PipeWire, ALSA y JACK
                  </div>
                  <h1>
                    El control total de tu Audient EVO, <em>ahora en Linux.</em>
                  </h1>
                  <p>
                    Ajusta la ganancia de tus preamps, activa 48V, silencia canales
                    y controla tu mezcla de monitoreo desde el escritorio o desde tu
                    móvil. Ligero, rápido y 100% open source.
                  </p>
                  <div class="hero-actions">
                    <a
                      class="button button-primary button-large"
                      href="https://sebaaguiar.github.io/evo-linux-control-suite/downloads/evo-suite-linux-x86_64.tar.gz"
                      ><svg
                        aria-hidden="true"
                        class="icon"
                        width="20"
                        height="20"
                        viewBox="0 0 24 24"
                        fill="none"
                        stroke="currentColor"
                        stroke-width="1.8"
                        stroke-linecap="round"
                        stroke-linejoin="round"
                      >
                        <path d="M12 3v12M7 10l5 5 5-5"></path>
                        <path d="M5 21h14"></path></svg
                      >Descargar para Linux</a
                    ><a class="button button-ghost button-large" href="#instalacion"
                      ><svg
                        aria-hidden="true"
                        class="icon"
                        width="20"
                        height="20"
                        viewBox="0 0 24 24"
                        fill="none"
                        stroke="currentColor"
                        stroke-width="1.8"
                        stroke-linecap="round"
                        stroke-linejoin="round"
                      >
                        <path d="m4 6 5 5-5 5M12 18h8"></path></svg
                      >Instalar con un comando</a
                    >
                  </div>
                  <div class="microcopy">
                    <span>Gratis</span><i></i><span>Código abierto</span><i></i
                    ><span>Sin telemetría</span>
                  </div>
                </div>
                <div class="hero-visual reveal visible">
                  <figure class="app-window app-window--shot">
                    <div class="window-top">
                      <div class="traffic"><i></i><i></i><i></i></div>
                      <span>EVO Linux Control Suite</span
                      ><span class="online"><i></i> EVO 4</span>
                    </div>
                    <div class="window-body window-body--shot">
                      <img
                        src={deck.src}
                        width="1240"
                        height="720"
                        decoding="async"
                        alt="Deck de escritorio de EVO Linux Control Suite: ganancia, 48 V y medidor del canal 1 de una Audient EVO 4"
                      />
                    </div>
                  </figure>
                  <div class="sync-line">
                    <i></i><span><b></b> CONECTADO</span>
                  </div>
                  <figure class="phone phone--shot">
                    <div class="phone-bar"></div>
                    <div class="phone-screen phone-screen--shot">
                      <img
                        src={controllerMobile.src}
                        width="780"
                        height="1688"
                        loading="lazy"
                        decoding="async"
                        alt="Controlador web de EVO Suite en un móvil, con el dial de ganancia del canal 1"
                      />
                    </div>
                  </figure>
                </div>
                <div class="distros reveal">
                  <span>Funciona donde tú trabajas</span><b><i></i>ARCH</b
                  ><b><i></i>UBUNTU</b><b><i></i>DEBIAN</b><b><i></i>FEDORA</b
                  ><b><i></i>openSUSE</b><b><i></i>SteamOS</b>
                </div>
              </section>
              <section class="section compare-section">
                <div class="container">
                  <div class="section-heading reveal">
                    <span class="eyebrow">EL CONTROL QUE FALTABA</span>
                    <h2>Linux merecía su propio panel de control</h2>
                    <p>
                      Audient no ofrece software oficial para Linux. Nosotros lo
                      construimos.
                    </p>
                  </div>
                  <div class="compare-grid">
                    <article class="compare-card before reveal">
                      <div class="card-label">
                        <span>ANTES</span><small>Sin EVO Suite</small>
                      </div>
                      <ul>
                        <li><i>×</i>Ajustes a ciegas con perillas físicas</li>
                        <li><i>×</i>Sin lectura exacta de dB en pantalla</li>
                        <li>
                          <i>×</i>Smartgain y monitoreo solo con la interfaz en la
                          mano
                        </li>
                        <li><i>×</i>Cero soporte para Linux</li>
                      </ul>
                    </article>
                    <article class="compare-card after reveal">
                      <div class="card-label">
                        <span>AHORA</span><small><i></i> Con EVO Suite</small>
                      </div>
                      <ul>
                        <li>
                          <i
                            ><svg
                              aria-hidden="true"
                              class="icon"
                              width="15"
                              height="15"
                              viewBox="0 0 24 24"
                              fill="none"
                              stroke="currentColor"
                              stroke-width="1.8"
                              stroke-linecap="round"
                              stroke-linejoin="round"
                            >
                              <path d="m5 12 4 4L19 6"></path></svg></i
                          >Lectura exacta y control bidireccional instantáneo por
                          USB
                        </li>
                        <li>
                          <i
                            ><svg
                              aria-hidden="true"
                              class="icon"
                              width="15"
                              height="15"
                              viewBox="0 0 24 24"
                              fill="none"
                              stroke="currentColor"
                              stroke-width="1.8"
                              stroke-linecap="round"
                              stroke-linejoin="round"
                            >
                              <path d="m5 12 4 4L19 6"></path></svg></i
                          >Daemon liviano (~6 MB de RAM) integrado con systemd
                        </li>
                        <li>
                          <i
                            ><svg
                              aria-hidden="true"
                              class="icon"
                              width="15"
                              height="15"
                              viewBox="0 0 24 24"
                              fill="none"
                              stroke="currentColor"
                              stroke-width="1.8"
                              stroke-linecap="round"
                              stroke-linejoin="round"
                            >
                              <path d="m5 12 4 4L19 6"></path></svg></i
                          >Control inalámbrico desde cualquier móvil, tablet o
                          laptop
                        </li>
                        <li>
                          <i
                            ><svg
                              aria-hidden="true"
                              class="icon"
                              width="15"
                              height="15"
                              viewBox="0 0 24 24"
                              fill="none"
                              stroke="currentColor"
                              stroke-width="1.8"
                              stroke-linecap="round"
                              stroke-linejoin="round"
                            >
                              <path d="m5 12 4 4L19 6"></path></svg></i
                          >Software abierto, hecho por y para la comunidad
                        </li>
                      </ul>
                    </article>
                  </div>
                </div>
              </section>
              <section class="section remote-section" id="control-remoto">
                <div class="container">
                  <div class="section-heading reveal">
                    <span class="eyebrow">CONTROL REMOTO · PWA</span>
                    <h2>Controla tu interfaz desde donde estés grabando</h2>
                    <p>
                      Ajusta ganancia, 48V y mutes desde tu móvil sin levantarte del
                      micrófono ni de la batería.
                    </p>
                  </div>
                  <div class="remote-layout">
                    <div class="steps reveal">
                      <div class="step">
                        <span>01</span>
                        <div>
                          <h3>Abre la app</h3>
                          <p>
                            El daemon crea un servidor local seguro en tiempo real.
                          </p>
                        </div>
                      </div>
                      <div class="step">
                        <span>02</span>
                        <div>
                          <h3>Escanea el QR</h3>
                          <p>
                            Apunta la cámara al código en pantalla. Sin escribir IPs
                            ni puertos.
                          </p>
                        </div>
                      </div>
                      <div class="step">
                        <span>03</span>
                        <div>
                          <h3>Ajusta desde la cabina</h3>
                          <p>
                            Controla tus preamps en vivo desde cualquier navegador
                            móvil.
                          </p>
                        </div>
                      </div>
                    </div>
                    <div class="remote-visual reveal">
                      <div class="qr-panel">
                        <div class="qr-top">
                          <span class="brand-mark"
                            ><span class="brand-tick"></span
                            ><span class="brand-core"></span></span
