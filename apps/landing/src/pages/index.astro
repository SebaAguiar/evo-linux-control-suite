              <section class="section features-section" id="caracteristicas">
                <div class="container">
                  <div class="section-heading reveal">
                    <span class="eyebrow">ARQUITECTURA SIN COMPROMISOS</span>
                    <h2>Hecho para rendir en tiempo real</h2>
                    <p>
